<Window x:Class="AeroPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroPicker"
        Width="1100"
        Height="780"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F0E8"
        Foreground="#1E1A16"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#DDD4C6" BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ResumeButton" Content="Master resume" Style="{StaticResource LinkButton}" Click="OpenResume_Click"/>
                    <Button x:Name="TokenButton" Content="API token" Style="{StaticResource LinkButton}" Click="OpenToken_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AeroPicker" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="MOCK" Margin="10,3,0,0" Foreground="#6D655C" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,32">
            <ContentControl x:Name="Host"/>
        </ScrollViewer>
    </DockPanel>
</Window>
