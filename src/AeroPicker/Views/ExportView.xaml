<UserControl x:Class="AeroPicker.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,0,0,16"/>
            <TextBlock Text="Export" FontFamily="Georgia" FontSize="32"/>
            <TextBlock TextWrapping="Wrap" Foreground="#6D655C" Margin="0,8,0,16"
                       Text="Pick a template for each document. Export writes the files, then opens Q/A. These files are text stand-ins. PDF rendering is not in this mock."/>

            <TextBlock Text="Resume template" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="ResumeClassic" Content="ATS Classic" GroupName="ResumeTemplate" Tag="ATS Classic" Margin="0,0,16,0" Checked="ResumeTemplate_Checked"/>
                <RadioButton x:Name="ResumeCompact" Content="ATS Compact" GroupName="ResumeTemplate" Tag="ATS Compact" Margin="0,0,16,0" Checked="ResumeTemplate_Checked"/>
                <RadioButton x:Name="ResumeModern" Content="Modern" GroupName="ResumeTemplate" Tag="Modern" Checked="ResumeTemplate_Checked"/>
            </StackPanel>

            <TextBlock Text="Cover letter template" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="LetterFormal" Content="Formal" GroupName="CoverTemplate" Tag="Formal" Margin="0,0,16,0" Checked="CoverTemplate_Checked"/>
                <RadioButton x:Name="LetterBrief" Content="Brief" GroupName="CoverTemplate" Tag="Brief" Checked="CoverTemplate_Checked"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Resume" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ResumePreview" Style="{StaticResource PreviewBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Cover letter" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="CoverPreview" Style="{StaticResource PreviewBox}"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="#8A3D12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Back_Click"/>
                <Button Content="Export" Style="{StaticResource PrimaryButton}" Click="Export_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
