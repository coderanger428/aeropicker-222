<UserControl x:Class="AeroPicker.Views.QaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AeroPicker.Views"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,0,0,16"/>
                <TextBlock Text="Application questions" FontFamily="Georgia" FontSize="32" TextWrapping="Wrap"/>
                <TextBlock TextWrapping="Wrap" Foreground="#6D655C" Margin="0,8,0,0"
                           Text="Ask each question from the form. The answer is drafted from the master resume, and you can copy it."/>
                <TextBlock x:Name="PathText" TextWrapping="Wrap" Foreground="#6D655C" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <TextBlock x:Name="EmptyText"
                           Text="Questions you ask will show up here."
                           Foreground="#6D655C"
                           TextWrapping="Wrap"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,4"/>
                <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=TranscriptScroll}">
                    <ItemsControl ItemsSource="{Binding Draft.Questions}" VerticalAlignment="Bottom">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <Border HorizontalAlignment="Right"
                                            MaxWidth="640"
                                            Background="#1E4D3A"
                                            CornerRadius="14"
                                            Padding="12,8"
                                            Margin="48,0,0,0">
                                        <TextBlock Text="{Binding Question}" Foreground="White" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border HorizontalAlignment="Left"
                                            MaxWidth="640"
                                            Background="#F6F1E8"
                                            BorderBrush="#DDD4C6"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12,8"
                                            Margin="0,8,48,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Answer}" TextWrapping="Wrap"/>
                                            <Button Content="Copy"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,8,0,0"
                                                    Padding="10,4"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="Copy_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <views:FieldCaption Text="Question" Requirement="Optional" Margin="0,0,0,6" Value="{Binding Text, ElementName=QuestionBox}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QuestionBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="44"
                             MaxHeight="96"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="QuestionBox_PreviewKeyDown"/>
                    <Button Grid.Column="1"
                            Content="Draft answer"
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="Draft_Click"/>
                </Grid>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Back_Click"/>
                    <Button Content="Finish application" Style="{StaticResource PrimaryButton}" Click="Finish_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
