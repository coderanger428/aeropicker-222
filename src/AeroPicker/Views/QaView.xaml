<UserControl x:Class="AeroPicker.Views.QaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,0,0,16"/>
            <TextBlock Text="Application questions" FontFamily="Georgia" FontSize="32"/>
            <TextBlock TextWrapping="Wrap" Foreground="#6D655C" Margin="0,8,0,8"
                       Text="If the form asks a follow-up, draft an answer from the master resume and edit it before keeping it. Finish works with no questions."/>
            <TextBlock x:Name="PathText" TextWrapping="Wrap" Foreground="#6D655C" FontSize="12" Margin="0,4,0,8"/>

            <TextBlock Text="Question" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="QuestionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>
            <Button Content="Draft answer" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Click="Draft_Click"/>

            <TextBlock Text="Suggested answer" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="AnswerBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" VerticalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="ErrorText" Foreground="#8A3D12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
            <Button Content="Keep answer" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Click="Keep_Click"/>

            <ItemsControl x:Name="QuestionList" ItemsSource="{Binding Draft.Questions}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" Margin="0,6,0,4"/>
                            <Button Content="Remove" HorizontalAlignment="Left" Style="{StaticResource TextButton}" Click="Remove_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Back_Click"/>
                <Button Content="Finish application" Style="{StaticResource PrimaryButton}" Click="Finish_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
