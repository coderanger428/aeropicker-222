<UserControl x:Class="AeroPicker.Views.TechNameBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SuggestionItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F6F1E8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E7F0EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Add_Click"/>
            <TextBox x:Name="Input"
                     PreviewKeyDown="Input_PreviewKeyDown"
                     TextChanged="Input_TextChanged"
                     LostKeyboardFocus="Input_LostKeyboardFocus"/>
        </DockPanel>
        <Popup x:Name="SuggestPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Input}"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0">
                <ListBox x:Name="Suggestions"
                         BorderThickness="0"
                         Background="White"
                         MaxHeight="240"
                         Focusable="False"
                         ItemContainerStyle="{StaticResource SuggestionItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="Suggestions_PreviewMouseLeftButtonDown"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
