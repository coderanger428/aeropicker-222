<UserControl x:Class="AeroPicker.Views.JobDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,0,0,16"/>
            <TextBlock Text="Job description" FontFamily="Georgia" FontSize="32"/>
            <TextBlock Text="Paste the full posting. Next reads the company, role, and skills out of it."
                       Foreground="#6D655C" TextWrapping="Wrap" Margin="0,8,0,4"/>
            <Border x:Name="Banner" Background="#E7F0EA" CornerRadius="10" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="BannerText" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="Job description" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DescriptionBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="420"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Draft.Description, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock x:Name="ErrorText" Foreground="#8A3D12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Use a sample posting" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Sample_Click"/>
                <Button Content="Next" Style="{StaticResource PrimaryButton}" Click="Next_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
