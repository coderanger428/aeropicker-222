<UserControl x:Class="AeroPicker.Views.JobReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,0,0,16"/>
            <TextBlock Text="Check the posting" FontFamily="Georgia" FontSize="32"/>
            <TextBlock Text="Fill any required field that is still empty. Optional fields can be skipped."
                       Foreground="#6D655C" TextWrapping="Wrap" Margin="0,8,0,8"/>

            <DockPanel Margin="0,12,0,6">
                <TextBlock x:Name="CompanyPill" DockPanel.Dock="Right"/>
                <TextBlock Text="Company" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBox x:Name="CompanyBox" Text="{Binding Draft.Company, UpdateSourceTrigger=PropertyChanged}" TextChanged="Refresh_TextChanged"/>

            <DockPanel Margin="0,14,0,6">
                <TextBlock x:Name="RolePill" DockPanel.Dock="Right"/>
                <TextBlock Text="Role" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBox x:Name="RoleBox" Text="{Binding Draft.Role, UpdateSourceTrigger=PropertyChanged}" TextChanged="Refresh_TextChanged"/>

            <DockPanel Margin="0,14,0,6">
                <TextBlock x:Name="SkillPill" DockPanel.Dock="Right"/>
                <TextBlock Text="Required skills" FontWeight="SemiBold"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Draft.Skills}" Margin="0,4,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F6F1E8" CornerRadius="12" Margin="0,0,8,8" Padding="10,4,4,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                <Button Content="Remove" Style="{StaticResource TextButton}" Click="RemoveSkill_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="AddSkill_Click"/>
                <TextBox x:Name="SkillBox" PreviewKeyDown="SkillBox_PreviewKeyDown"/>
            </DockPanel>

            <DockPanel Margin="0,14,0,6">
                <TextBlock x:Name="LocationPill" DockPanel.Dock="Right"/>
                <TextBlock Text="Location" FontWeight="SemiBold"/>
            </DockPanel>
            <DockPanel>
                <Button x:Name="LocationSkip" DockPanel.Dock="Right" Content="Skip" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SkipLocation_Click"/>
                <Button x:Name="LocationFill" Content="Fill" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="FillLocation_Click" Visibility="Collapsed"/>
                <TextBox x:Name="LocationBox" Text="{Binding Draft.Location, UpdateSourceTrigger=PropertyChanged}" TextChanged="Refresh_TextChanged"/>
            </DockPanel>

            <DockPanel Margin="0,14,0,6">
                <TextBlock x:Name="SeniorityPill" DockPanel.Dock="Right"/>
                <TextBlock Text="Seniority" FontWeight="SemiBold"/>
            </DockPanel>
            <DockPanel>
                <Button x:Name="SenioritySkip" DockPanel.Dock="Right" Content="Skip" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SkipSeniority_Click"/>
                <Button x:Name="SeniorityFill" Content="Fill" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="FillSeniority_Click" Visibility="Collapsed"/>
                <TextBox x:Name="SeniorityBox" Text="{Binding Draft.Seniority, UpdateSourceTrigger=PropertyChanged}" TextChanged="Refresh_TextChanged"/>
            </DockPanel>

            <TextBlock x:Name="HintText" Text="Company, role, and at least one skill are required before Generate."
                       Foreground="#6D655C" FontSize="12" Margin="0,14,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Back_Click"/>
                <Button x:Name="GenerateButton" Content="Generate" Style="{StaticResource PrimaryButton}" Click="Generate_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
