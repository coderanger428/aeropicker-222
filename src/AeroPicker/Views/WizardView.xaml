<UserControl x:Class="AeroPicker.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mock="clr-namespace:AeroPicker.Mock.Models"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,8,18,0">
            <Button x:Name="StepButton0" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="0"/>
            <Button x:Name="StepButton1" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="1"/>
            <Button x:Name="StepButton2" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="2"/>
            <Button x:Name="StepButton3" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="3"/>
            <Button x:Name="StepButton4" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="4"/>
            <Button x:Name="StepButton5" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="5"/>
            <Button x:Name="StepButton6" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="6"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="Eyebrow" Text="SETUP" Foreground="#1E4D3A" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="Heading" FontFamily="Georgia" FontSize="32" Margin="0,8,0,0"/>
                <TextBlock x:Name="Lede" Foreground="#6D655C" TextWrapping="Wrap" Margin="0,8,0,8"/>

                <StackPanel x:Name="Step0">
                    <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Profile.FullName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Profile.Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Profile.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Profile.Location, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Summary" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Profile.Summary, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <StackPanel x:Name="Step1" Visibility="Collapsed">
                    <TextBlock Text="No roles yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Career.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Career}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource TextButton}" Click="RemoveCareer_Click"/>
                                            <TextBlock Text="Role" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="Job title" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Employer" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Employer, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Start" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="End" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding End, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding Current, Converter={StaticResource InverseBool}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Content="I currently work here" IsChecked="{Binding Current}" Margin="0,12,0,0"/>
                                        <TextBlock Text="Highlights" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Highlights, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add a role" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddCareer_Click"/>
                </StackPanel>

                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Text="No skills yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Skills.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Skills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F6F1E8" CornerRadius="12" Margin="0,0,8,8" Padding="10,4,4,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        <Button Content="Remove" Style="{StaticResource TextButton}" Click="RemoveSkill_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="AddSkill_Click"/>
                        <TextBox x:Name="SkillBox" PreviewKeyDown="SkillBox_PreviewKeyDown"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock Text="No projects yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Projects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource TextButton}" Click="RemoveProject_Click"/>
                                            <TextBlock Text="Project" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="Project" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Your role" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="What you did" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add a project" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddProject_Click"/>
                </StackPanel>

                <StackPanel x:Name="Step4" Visibility="Collapsed">
                    <TextBlock Text="No education yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Education.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Education}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource TextButton}" Click="RemoveEducation_Click"/>
                                            <TextBlock Text="Education" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="Institution" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Institution, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Credential" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Credential, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Year" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add education" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddEducation_Click"/>
                </StackPanel>

                <StackPanel x:Name="Step5" Visibility="Collapsed">
                    <TextBlock Text="No certificates or achievements yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Credentials.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Credentials}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource TextButton}" Click="RemoveCredential_Click"/>
                                            <TextBlock Text="Item" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="Kind" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedItem="{Binding Kind}">
                                            <sys:String>Certificate</sys:String>
                                            <sys:String>Achievement</sys:String>
                                        </ComboBox>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Issuer or context" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Issuer, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Year" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add an item" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddCredential_Click"/>
                </StackPanel>

                <StackPanel x:Name="Step6" Visibility="Collapsed">
                    <TextBlock Text="Provider" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static mock:Templates.Providers}" SelectedItem="{Binding Profile.Provider}"/>
                    <TextBlock Text="API token" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="TokenBox" Padding="10,8"/>
                    <TextBlock x:Name="TokenSaved" Text="A token is already saved on this machine." Foreground="#6D655C" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#6D655C" FontSize="12" Margin="0,8,0,0"
                               Text="This mock stores the token in a local file. It is not encrypted, and no model is called."/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#8A3D12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CloseButton" Content="Close" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Close_Click"/>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Back_Click"/>
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource PrimaryButton}" Click="Next_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
