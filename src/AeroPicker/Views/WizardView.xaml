<UserControl x:Class="AeroPicker.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mock="clr-namespace:AeroPicker.Mock.Models"
             xmlns:views="clr-namespace:AeroPicker.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,8,18,0">
            <Button x:Name="StepButton0" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="0"/>
            <Button x:Name="StepButton1" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="1"/>
            <Button x:Name="StepButton2" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="2"/>
            <Button x:Name="StepButton3" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="3"/>
            <Button x:Name="StepButton4" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="4"/>
            <Button x:Name="StepButton5" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="5"/>
            <Button x:Name="StepButton6" Style="{StaticResource TextButton}" HorizontalContentAlignment="Left" Click="Step_Click" Tag="6"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="Eyebrow" Text="SETUP" Foreground="#1E4D3A" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="Heading" FontFamily="Georgia" FontSize="32" Margin="0,8,0,0"/>
                <TextBlock x:Name="Lede" Foreground="#6D655C" TextWrapping="Wrap" Margin="0,8,0,8"/>

                <StackPanel x:Name="Step0">
                    <views:FieldCaption Text="Full name" Requirement="Required" Value="{Binding Text, ElementName=NameBox}"/>
                    <TextBox x:Name="NameBox" Text="{Binding Profile.FullName, UpdateSourceTrigger=PropertyChanged}"/>
                    <views:FieldCaption Text="Email" Requirement="Required" Value="{Binding Text, ElementName=EmailBox}"/>
                    <TextBox x:Name="EmailBox" Text="{Binding Profile.Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <views:FieldCaption Text="Phone" Requirement="Required" Value="{Binding Text, ElementName=PhoneBox}"/>
                    <TextBox x:Name="PhoneBox" Text="{Binding Profile.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    <views:FieldCaption Text="Location" Requirement="Required" Value="{Binding Text, ElementName=LocationBox}"/>
                    <TextBox x:Name="LocationBox" Text="{Binding Profile.Location, UpdateSourceTrigger=PropertyChanged}"/>
                    <views:FieldCaption Text="LinkedIn" Requirement="Required" Value="{Binding Text, ElementName=LinkedInBox}"/>
                    <TextBox x:Name="LinkedInBox" Text="{Binding Profile.LinkedIn, UpdateSourceTrigger=PropertyChanged}"/>
                    <views:FieldCaption Text="GitHub" Requirement="Optional" Value="{Binding Text, ElementName=GitHubBox}"/>
                    <TextBox x:Name="GitHubBox" Text="{Binding Profile.GitHub, UpdateSourceTrigger=PropertyChanged}"/>
                    <views:FieldCaption Text="X" Requirement="Optional" Value="{Binding Text, ElementName=XBox}"/>
                    <TextBox x:Name="XBox" Text="{Binding Profile.X, UpdateSourceTrigger=PropertyChanged}"/>
                    <views:FieldCaption Text="Facebook" Requirement="Optional" Value="{Binding Text, ElementName=FacebookBox}"/>
                    <TextBox x:Name="FacebookBox" Text="{Binding Profile.Facebook, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel x:Name="Step1" Visibility="Collapsed">
                    <TextBlock Text="No companies yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Career.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Career}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" VerticalAlignment="Center" Style="{StaticResource TextButton}" Click="RemoveCareer_Click"/>
                                            <views:FieldCaption Text="Company" Requirement="Required" Margin="0,0,0,6" Value="{Binding Text, ElementName=CompanyBox}"/>
                                        </DockPanel>
                                        <TextBox x:Name="CompanyBox" Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"/>
                                        <views:FieldCaption Text="Location" Requirement="Optional" Value="{Binding Text, ElementName=CompanyLocationBox}"/>
                                        <TextBox x:Name="CompanyLocationBox" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <views:FieldCaption Text="Start" Requirement="Required" Value="{Binding Text, ElementName=StartBox}"/>
                                                <TextBox x:Name="StartBox" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <views:FieldCaption Text="End" Value="{Binding Text, ElementName=EndBox}"
                                                                    Requirement="{Binding IsChecked, ElementName=CurrentBox, Converter={StaticResource EndDateRequirement}}"/>
                                                <TextBox x:Name="EndBox" Text="{Binding End, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding IsChecked, ElementName=CurrentBox, Converter={StaticResource InverseBool}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="CurrentBox" Content="Currently working" IsChecked="{Binding Current}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add company" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddCareer_Click"/>
                </StackPanel>

                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <views:FieldCaption x:Name="SkillCaption" Text="Skills" Requirement="Optional"/>
                    <TextBlock Text="No skills yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Skills.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Skills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F6F1E8" CornerRadius="12" Margin="0,0,8,8" Padding="10,4,4,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        <Button Content="×" FontSize="16" Padding="6,0" VerticalAlignment="Center" ToolTip="Remove" Style="{StaticResource TextButton}" Click="RemoveSkill_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <views:TechNameBox x:Name="SkillEntry" Margin="0,8,0,0" Committed="Skill_Committed"/>
                </StackPanel>

                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock Text="No projects yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Projects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource TextButton}" Click="RemoveProject_Click"/>
                                            <TextBlock Text="Project" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <views:FieldCaption Text="Project" Requirement="Required" Value="{Binding Text, ElementName=ProjectBox}"/>
                                        <TextBox x:Name="ProjectBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <views:FieldCaption Text="Your role" Requirement="Required" Value="{Binding Text, ElementName=ProjectRoleBox}"/>
                                        <TextBox x:Name="ProjectRoleBox" Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"/>
                                        <views:FieldCaption Text="What you did" Requirement="Optional" Value="{Binding Text, ElementName=ProjectDetailsBox}"/>
                                        <TextBox x:Name="ProjectDetailsBox" Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add a project" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddProject_Click"/>
                </StackPanel>

                <StackPanel x:Name="Step4" Visibility="Collapsed">
                    <TextBlock Text="No education yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Education.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Education}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource TextButton}" Click="RemoveEducation_Click"/>
                                            <TextBlock Text="Education" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <views:FieldCaption Text="Institution" Requirement="Required" Value="{Binding Text, ElementName=InstitutionBox}"/>
                                        <TextBox x:Name="InstitutionBox" Text="{Binding Institution, UpdateSourceTrigger=PropertyChanged}"/>
                                        <views:FieldCaption Text="Credential" Requirement="Required" Value="{Binding Text, ElementName=CredentialBox}"/>
                                        <TextBox x:Name="CredentialBox" Text="{Binding Credential, UpdateSourceTrigger=PropertyChanged}"/>
                                        <views:FieldCaption Text="Year" Requirement="Optional" Value="{Binding Text, ElementName=EducationYearBox}"/>
                                        <TextBox x:Name="EducationYearBox" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add education" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddEducation_Click"/>
                </StackPanel>

                <StackPanel x:Name="Step5" Visibility="Collapsed">
                    <TextBlock Text="No certificates or achievements yet." Foreground="#6D655C" Margin="0,8,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.Credentials.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Profile.Credentials}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD4C6" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource TextButton}" Click="RemoveCredential_Click"/>
                                            <TextBlock Text="Item" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <views:FieldCaption Text="Kind" Requirement="Required" Value="{Binding SelectedItem, ElementName=KindBox}"/>
                                        <ComboBox x:Name="KindBox" SelectedItem="{Binding Kind}">
                                            <sys:String>Certificate</sys:String>
                                            <sys:String>Achievement</sys:String>
                                        </ComboBox>
                                        <views:FieldCaption Text="Name" Requirement="Required" Value="{Binding Text, ElementName=CredentialNameBox}"/>
                                        <TextBox x:Name="CredentialNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <views:FieldCaption Text="Issuer or context" Requirement="Optional" Value="{Binding Text, ElementName=IssuerBox}"/>
                                        <TextBox x:Name="IssuerBox" Text="{Binding Issuer, UpdateSourceTrigger=PropertyChanged}"/>
                                        <views:FieldCaption Text="Year" Requirement="Optional" Value="{Binding Text, ElementName=CredentialYearBox}"/>
                                        <TextBox x:Name="CredentialYearBox" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add an item" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddCredential_Click"/>
                </StackPanel>

                <StackPanel x:Name="Step6" Visibility="Collapsed">
                    <views:FieldCaption Text="Provider" Requirement="Required" Value="{Binding SelectedItem, ElementName=ProviderBox}"/>
                    <ComboBox x:Name="ProviderBox" ItemsSource="{x:Static mock:Templates.Providers}" SelectedItem="{Binding Profile.Provider}"/>
                    <views:FieldCaption x:Name="TokenCaption" Text="API token" Requirement="Required"/>
                    <PasswordBox x:Name="TokenBox" Padding="10,8" PasswordChanged="TokenBox_PasswordChanged"/>
                    <TextBlock x:Name="TokenSaved" Text="A token is already saved on this machine." Foreground="#6D655C" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#6D655C" FontSize="12" Margin="0,8,0,0"
                               Text="This mock stores the token in a local file. It is not encrypted, and no model is called."/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#8A3D12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CloseButton" Content="Close" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Close_Click"/>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Back_Click"/>
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource PrimaryButton}" Click="Next_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
